# sparkkeep — self-hosted capture & organize. Copy to .env.
SPARKKEEP_DB=/data/sparkkeep.db
SPARKKEEP_HTTP_ADDR=:8080
# Optional host port mapping for docker-compose (defaults to 8080)
# SPARKKEEP_HTTP_PORT=8080
# Recommended way to protect the dashboard/API. When set, every request must
# present this token; leave it empty only for a trusted, non-exposed instance.
SPARKKEEP_AUTH_TOKEN=
# OpenAI-compatible endpoint. Ollama default; set to any provider w/ key.
SPARKKEEP_LLM_BASE=http://host.docker.internal:11434/v1
SPARKKEEP_LLM_KEY=
SPARKKEEP_LLM_MODEL=
# Model used for image analysis. Defaults to SPARKKEEP_LLM_MODEL.
SPARKKEEP_VISION_MODEL=
SPARKKEEP_MAX_ANALYZE_TOKENS=2048
# Telegram (optional)
SPARKKEEP_TG_TOKEN=
SPARKKEEP_TG_CHAT_ID=
SPARKKEEP_OFFSET_FILE=/data/bot_offset.json
# Weekly digest push. Enabled by default once SPARKKEEP_TG_TOKEN is set.
SPARKKEEP_DIGEST_PUSH_ENABLED=true
# Digest day (0=Sunday..6) and hour (0..23), both local time.
SPARKKEEP_DIGEST_PUSH_DAY=0
SPARKKEEP_DIGEST_PUSH_HOUR=19
# Public URL used in research report links
SPARKKEEP_PUBLIC_URL=http://localhost:8080
# Search backend (SearXNG JSON). Leave empty = public default (searx.be).
# Point at your own instance to override, e.g. http://searxng:8080
SPARKKEEP_SEARCH_URL=
# Headless browser scraping toggle (Chromium). Set to false on memory-constrained devices.
SPARKKEEP_HEADLESS_ENABLED=true
# Explicit scraper tool paths. Leave empty to auto-detect on PATH.
SPARKKEEP_CHROME_BIN=
SPARKKEEP_YTDLP=yt-dlp
SPARKKEEP_FFMPEG_BIN=
# Netscape cookies file for authenticated scraping (optional).
SPARKKEEP_COOKIES_FILE=
# Uploaded media directory. Defaults to <dbdir>/uploads.
SPARKKEEP_UPLOAD_DIR=/data/uploads
# Max size of a single upload, in MB.
SPARKKEEP_MAX_UPLOAD_MB=25
# Upload cleanup limits. 0 disables the corresponding cleanup.
SPARKKEEP_UPLOAD_MAX_SIZE_MB=0
SPARKKEEP_UPLOAD_MAX_AGE_DAYS=0
# Audio transcription / Whisper backend (optional). E.g. http://whisper:9000
SPARKKEEP_ASR_URL=
# Whisper model name; backend default when empty.
SPARKKEEP_ASR_MODEL=
# Preferred subtitle/transcript languages passed to yt-dlp.
SPARKKEEP_TRANSCRIPT_LANGS=en.*,en

# Multi-Channel Integrations (optional)
# Discord
SPARKKEEP_DISCORD_TOKEN=
SPARKKEEP_DISCORD_CHANNEL_ID=
SPARKKEEP_DISCORD_PUBLIC_KEY=

# Slack
SPARKKEEP_SLACK_WEBHOOK_URL=
SPARKKEEP_SLACK_BOT_TOKEN=
SPARKKEEP_SLACK_CHANNEL_ID=

# OpenClaw gateway
SPARKKEEP_OPENCLAW_URL=http://localhost:18789
SPARKKEEP_OPENCLAW_TOKEN=
SPARKKEEP_OPENCLAW_CHANNEL=whatsapp
SPARKKEEP_OPENCLAW_TARGET=
